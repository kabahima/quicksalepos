DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=api.example.com

# Comma-separated frontend origins. Include the Vercel preview domain if needed.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# Production database. Vercel requires PostgreSQL or another persistent database.
DATABASE_URL=postgresql://user:password@host:5432/database

# Alternatively, use these individual PostgreSQL settings instead of DATABASE_URL.
# POSTGRES_DB=database
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=host
# POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=receipts@example.com